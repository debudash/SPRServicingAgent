# Copy to .env and fill in. NEVER commit the real .env. Settings: docs/ARCHITECTURE.md section 5.
# The v1 baseline keeps its own list in baseline/.env.example; both read this same root .env.

# Product runtime and evals (API credits). Build agents use Claude plan tokens instead, set as GitHub secrets.
ANTHROPIC_API_KEY=

# Optional tracing; leave empty to trace nothing (traces are scrubbed either way).
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=spr-servicing-desk

# The business clock (PRD D-04). Never "today".
DESK_AS_OF=2024-12-01

# HMAC key for approval tokens (B3). Generate one per environment, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
APPROVAL_SECRET=

# Kill switch for execution (FR-26): false routes every withdrawal to a human.
EXECUTION_ENABLED=true

# Where desk.db, checkpoints.db and the Chroma index live.
DESK_VAR_DIR=var
