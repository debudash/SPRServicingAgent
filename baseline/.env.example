# Copy to .env and fill in. NEVER commit the real .env.

# --- The three benchmarked models ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Which model judges the benchmark (LLM-as-judge).
# Prefer `openrouter`: it is NOT one of the benchmarked models, so it has no stake in
# what it grades, and it accepts temperature=0 (claude-sonnet-5 does not).
JUDGE_MODEL=openrouter

# --- The neutral judge: OpenRouter (free key at openrouter.ai) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# --- Data / RAG (all local, no key needed) ---
ACCOUNTS_PATH=data/accounts.json
KB_DIR=knowledge_base
CHROMA_DIR=./chroma_db
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Runtime guardrails (loops + cost) ---
MAX_AGENT_STEPS=8
MAX_CONSECUTIVE_FAILURES=2
MAX_OUTPUT_TOKENS=1024
